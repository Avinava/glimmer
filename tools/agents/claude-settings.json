{
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|elicitation_dialog",
        "hooks": [{ "type": "command", "command": "$HOME/.local/bin/glimmer-hook.sh claude", "async": true, "timeout": 5 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "$HOME/.local/bin/glimmer-hook.sh claude", "async": true, "timeout": 5 }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "$HOME/.local/bin/glimmer-hook.sh claude", "async": true, "timeout": 5 }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "$HOME/.local/bin/glimmer-hook.sh claude", "async": true, "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "$HOME/.local/bin/glimmer-hook.sh claude", "async": true, "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "$HOME/.local/bin/glimmer-hook.sh claude", "async": true, "timeout": 5 }] }
    ]
  }
}
