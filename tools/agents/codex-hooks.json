{
  "description": "Show Codex approvals on a glimmer desk display",
  "hooks": {
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "$HOME/.local/bin/glimmer-hook.sh codex", "async": true, "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "$HOME/.local/bin/glimmer-hook.sh codex", "async": true, "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "$HOME/.local/bin/glimmer-hook.sh codex", "async": true, "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "$HOME/.local/bin/glimmer-hook.sh codex", "async": true, "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "$HOME/.local/bin/glimmer-hook.sh codex", "async": true, "timeout": 5 }] }
    ]
  }
}
